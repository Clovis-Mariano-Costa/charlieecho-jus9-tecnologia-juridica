# Copie para .env apenas no ambiente local, se necessário.
# Nunca publique .env real, tokens, chaves ou credenciais.

# WhatsApp Cloud API / Render
PORT=3000
VERIFY_TOKEN=jus9_echo_verify_2026
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0
NODE_ENV=development

# Drive Saver MVP / Google Apps Script
# Configure apenas no Render, sem publicar URL ativa nem chave real.
JUS9_DRIVE_SAVER_URL=
JUS9_DRIVE_SAVER_CHAVE_INTERNA=
# Use JURIDICO_SIGILOSO por padrao.
# Para deposito write-only no cofre, configure COFRE_DEPOSITO_ASSISTIDO e ajuste o Apps Script.
JUS9_DRIVE_SAVER_CLASSIFICACAO_PROTOCOLO=JURIDICO_SIGILOSO

# Charlie Echo / Jus 9 - IA API
# Configure secrets reais no provedor seguro, nunca no GitHub público.
OPENAI_API_KEY=
JUS9_CONTACT_EMAIL=charlieecho@jus9tecnologia.com.br
JUS9_MODEL_DEFAULT=gpt-5.5
JUS9_MODEL_ESTUDANTES=
JUS9_MODEL_PROFISSIONAL=
JUS9_MODEL_SOCIAL=
